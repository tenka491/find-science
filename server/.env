DATABASE_URL=sqlite://data.db

# Set AI_PROVIDER=ollama and run ./scripts/dev-ai to enable photo search.
AI_PROVIDER=mock
# AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llava

# Leave PROJECTS_API_URL unset to use built-in mock project data.
# PROJECTS_API_KEY=your_api_key_here
# PROJECTS_BASE_URL=https://acme-science.example/
# PROJECTS_API_URL=https://api.acme-science.example/projects?format=json